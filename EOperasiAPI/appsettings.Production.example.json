{
  // Copy this file to appsettings.Production.json ON THE SERVER and fill it in.
  // appsettings.Production.json is in .gitignore: it must never go to GitHub.
  // Each value can instead be given as an environment variable, e.g.
  //   ConnectionStrings__Default, Jwt__Key, Smtp__Password, FrontendUrl
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "EOperasiApi": "Information"
    }
  },

  // Server name(s) people type in the browser, e.g. "eoperasi.ppdjb.edu.my".
  "AllowedHosts": "*",

  "ConnectionStrings": {
    // Use a strong database password, different from the development one.
    "Default": "Host=localhost;Port=5432;Database=eoperasi;Username=eoperasi;Password=CHANGE_ME"
  },

  "Jwt": {
    // A NEW random key for this server (at least 32 characters). See DEPLOYMENT.md.
    // The API refuses to start if this still contains CHANGE_ME.
    "Key": "CHANGE_ME",
    "Issuer": "EOperasiApi",
    "ExpiresInMinutes": 480
  },

  // The address people open e-Operasi with. Used for the links in emails
  // (verification, password reset, account approved).
  "FrontendUrl": "https://CHANGE_ME",

  // Only needed if the dashboard is served from a DIFFERENT address than the API.
  // If you use "npm run build:server" (dashboard inside the API), leave this empty.
  "Cors": {
    "AllowedOrigins": []
  },

  // Set to true once the server has an HTTPS certificate.
  "Https": {
    "Enabled": false
  },

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    // Use an official PPD/KPM mailbox, not a personal one.
    "Username": "CHANGE_ME",
    "Password": "CHANGE_ME",
    "FromEmail": "CHANGE_ME",
    "FromName": "e-Operasi PPD Johor Bahru",
    "EnableSsl": "true"
  }
}
